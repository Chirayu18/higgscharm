# negrw v2 retraining (2026-11-12): one CPU job in the processing workers' image (sklearn 1.7.2)
universe                = vanilla
executable              = negrw_train_v2_exec.sh
+SingularityImage       = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/coffeateam/coffea-base-almalinux9:0.7.30-py3.10"
transfer_input_files    = negrw_train_v2_exec.sh, negrw_train_v2.py, train_v2.parquet, sr_allfix_v1_20261110.parquet
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = out
output                  = negrw_train_v2.$(ClusterId).out
error                   = negrw_train_v2.$(ClusterId).err
log                     = negrw_train_v2.$(ClusterId).log
request_cpus            = 4
request_memory          = 16 GB
request_disk            = 6 GB
+JobFlavour             = "workday"
queue 1
